# Copy to .env and fill in values
SECRET_KEY=change-me
DEBUG=True
# SQLite by default; for PostgreSQL:
# DATABASE_URL=postgres://erp:erp@localhost:5432/erp
# DATABASE_URL=sqlite:///db.sqlite3
WAGTAILADMIN_BASE_URL=http://localhost:8000
# AI provider: openai (key sk-...) or gemini (Google AI Studio key)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# AI_MODEL=gpt-4o-mini        # default for openai; gemini default: gemini-flash-latest
# Production only
# ALLOWED_HOSTS=erp.example.com
# CSRF_TRUSTED_ORIGINS=https://erp.example.com
# HTTPS=True
# POSTGRES_PASSWORD=change-me   (docker compose)

# --- Apache Superset (docker-compose.analytics.yml) ---
# Khi chạy stack phân tích, Django trỏ vào Postgres thay cho SQLite.
# Dùng 127.0.0.1 chứ KHÔNG dùng localhost: trên Windows localhost phân giải ra ::1
# trước, mà Docker chỉ lắng nghe IPv4 -> mỗi kết nối phải chờ hết timeout TCP.
# DATABASE_URL=postgres://erp:erp@127.0.0.1:5433/erp
# Role chỉ-đọc mà Superset dùng để kết nối (không có quyền trên schema public)
SUPERSET_DB_USER=superset_ro
SUPERSET_DB_PASSWORD=change-me
# Bí mật của Superset - bắt buộc đổi, sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_PASSWORD=change-me
# Email for workflow notifications (default: printed to console)
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# DEFAULT_FROM_EMAIL=erp@example.com
